<!-- Overlay -->
<div id="cart-drawer-overlay"></div>

<!-- Panel del carrito -->
<div id="cart-drawer" role="dialog" aria-modal="true" aria-label="Carrito de compras">

  <!-- Cabecera -->
  <div id="cd-header">
    <h2 id="cd-title">0 productos</h2>
    <button id="cd-close-btn" type="button" onclick="CartDrawer.close()" aria-label="Cerrar carrito">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2.5"
           stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <!-- Barra de progreso -->
  <div id="cd-progress-wrap">
    <div id="cd-progress-bar-container">

      <!-- Track -->
      <div id="cd-progress-bar-track">
        <div id="cd-progress-fill"></div>
      </div>

      <!-- Marcador izquierdo: Pedido Mínimo (✓) -->
      <div class="cd-threshold-group left">
        <div id="cd-marker-min" class="cd-marker">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
               stroke="#fff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </div>
        <div class="cd-threshold-label-wrap">
          <p class="cd-threshold-amount">€15</p>
          <p class="cd-threshold-label">Pedido Mínimo</p>
        </div>
      </div>

      <!-- Marcador derecho: Envío Gratis (camión) -->
      <div class="cd-threshold-group right">
        <div id="cd-marker-free" class="cd-marker">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
               stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13" rx="1"/>
            <path d="M16 8h4l3 6v3h-7V8z"/>
            <circle cx="5.5" cy="18.5" r="2.5"/>
            <circle cx="18.5" cy="18.5" r="2.5"/>
          </svg>
        </div>
        <div class="cd-threshold-label-wrap">
          <p class="cd-threshold-amount">€35</p>
          <p class="cd-threshold-label">Envío Gratis</p>
        </div>
      </div>

    </div>
  </div>

  <div class="cd-divider"></div>

  <!-- Zona de scroll: items + upsell -->
  <div id="cart-items-scroll">

    <!-- Spinner de carga -->
    <div id="cd-loading">
      <div class="cd-spinner"></div>
    </div>

    <!-- Lista de items (renderizada por JS) -->
    <div id="cd-items-list"></div>

    <!-- Estado vacío -->
    <div id="cd-empty">
      <svg width="44" height="44" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.4">
        <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
        <line x1="3" y1="6" x2="21" y2="6"/>
        <path d="M16 10a4 4 0 01-8 0"/>
      </svg>
      <p>Tu carrito está vacío</p>
    </div>

    <!-- Upsell (fondo negro) -->
    <div id="cd-upsell">
      <div class="cd-upsell-inner">
        <div class="cd-upsell-img-wrap">
          <img id="cd-upsell-img" src="" alt="" loading="lazy">
        </div>
        <div class="cd-upsell-info">
          <p id="cd-upsell-title"></p>
          <p id="cd-upsell-price"></p>
        </div>
        <button type="button" class="cd-upsell-btn" onclick="CartDrawer.addUpsell()">Agregar</button>
      </div>
    </div>

  </div>

  <!-- Footer -->
  <div id="cd-footer">
    <div class="cd-subtotal-row">
      <span class="cd-subtotal-label">Subtotal</span>
      <span id="cd-subtotal">—</span>
    </div>
    <p class="cd-disclaimer">
      *en la pantalla de pagos se incluye el impuesto y se calculan los gastos de envío.
    </p>
    <a href="{{ routes.checkout_url }}" class="cd-checkout-btn">
      Realizar Pago Seguro
    </a>
    <div class="cd-payment-icons">
      {%- for type in shop.enabled_payment_types -%}
        <span>{{- type | payment_type_svg_tag -}}</span>
      {%- endfor -%}
    </div>
  </div>

</div>

<script>
  window.CART_MIN_CENTS  = 1500;
  window.CART_FREE_CENTS = 3500;
  window.CART_MONEY_FMT  = {{ shop.money_format | json }};
</script>
