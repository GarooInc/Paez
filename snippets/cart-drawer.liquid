{%- liquid
  assign min_cents  = 1500
  assign free_cents = 3500
  assign min_pct    = min_cents | times: 100 | divided_by: free_cents
-%}

<style>
  /* ---------- Cart Drawer ---------- */
  #cart-drawer-overlay {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  #cart-drawer-overlay.cd-open {
    opacity: 1;
    pointer-events: auto;
  }

  #cart-drawer {
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }
  #cart-drawer.cd-open {
    transform: translateX(0);
  }

  /* Ocultar scrollbar en los items */
  #cart-items-scroll::-webkit-scrollbar { width: 0; }
  #cart-items-scroll { scrollbar-width: none; }

  /* Animación entrada de items */
  @keyframes cdItemIn {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .cd-item { animation: cdItemIn 0.18s ease; }

  /* Spinner de carga */
  @keyframes cdSpin { to { transform: rotate(360deg); } }
  .cd-spinner {
    border: 2px solid #e5e7eb;
    border-top-color: #000;
    border-radius: 50%;
    animation: cdSpin 0.6s linear infinite;
  }
</style>

<!-- Overlay oscuro -->
<div id="cart-drawer-overlay" class="fixed inset-0 bg-black/60 z-[998]"></div>

<!-- Panel del carrito -->
<div
  id="cart-drawer"
  class="fixed top-0 right-0 h-full w-full md:max-w-[400px] bg-white z-[999] flex flex-col"
  role="dialog"
  aria-modal="true"
  aria-label="Carrito de compras"
>

  <!-- ── Cabecera ── -->
  <div class="relative flex items-center justify-center px-6 pt-6 pb-4 flex-shrink-0">
    <h2 id="cd-title" class="text-2xl font-bold text-black">0 productos</h2>
    <button
      type="button"
      onclick="CartDrawer.close()"
      aria-label="Cerrar carrito"
      class="absolute right-5 top-5 p-1 text-black hover:opacity-50 transition-opacity"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2.5"
           stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <!-- ── Barra de progreso ── -->
  <div class="px-6 pb-4 flex-shrink-0">
    <div class="relative mx-2.5" style="padding: 10px 0">
      <div class="h-1.5 bg-gray-200 rounded-full relative">
        <!-- Fill -->
        <div
          id="cd-progress-fill"
          class="absolute left-0 top-0 h-full bg-black rounded-full"
          style="width: 0%; transition: width 0.5s ease"
        ></div>
        <!-- Círculo: Pedido Mínimo -->
        <div
          id="cd-marker-min"
          class="absolute top-1/2 w-5 h-5 rounded-full bg-gray-300 flex items-center justify-center -translate-y-1/2"
          style="left: calc({{ min_pct }}% - 10px); transition: background-color 0.3s"
        >
          <span class="block w-2 h-2 rounded-full bg-white"></span>
        </div>
        <!-- Círculo: Envío gratis -->
        <div
          id="cd-marker-free"
          class="absolute top-1/2 w-5 h-5 rounded-full bg-gray-300 flex items-center justify-center -translate-y-1/2"
          style="right: -10px; transition: background-color 0.3s"
        >
          <span class="block w-2 h-2 rounded-full bg-white"></span>
        </div>
      </div>
    </div>
    <div class="flex justify-between mt-2">
      <div>
        <p class="text-sm font-bold text-black">{{ min_cents | money_without_trailing_zeros }}</p>
        <p class="text-xs text-gray-500">Pedido Mínimo</p>
      </div>
      <div class="text-right">
        <p class="text-sm font-bold text-black">{{ free_cents | money_without_trailing_zeros }}</p>
        <p class="text-xs text-gray-500">Envío Gratis</p>
      </div>
    </div>
  </div>

  <div class="h-px bg-gray-100 mx-5 flex-shrink-0"></div>

  <!-- ── Zona de scroll: items + upsell ── -->
  <div id="cart-items-scroll" class="flex-1 overflow-y-auto min-h-0">

    <!-- Estado de carga -->
    <div id="cd-loading" class="hidden flex items-center justify-center py-12">
      <div class="cd-spinner w-8 h-8"></div>
    </div>

    <!-- Items -->
    <div id="cd-items-list"></div>

    <!-- Carrito vacío -->
    <div id="cd-empty" class="hidden flex flex-col items-center justify-center py-16 px-6 text-gray-400">
      <svg width="44" height="44" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.4">
        <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
        <line x1="3" y1="6" x2="21" y2="6"/>
        <path d="M16 10a4 4 0 01-8 0"/>
      </svg>
      <p class="mt-3 text-sm font-medium">Tu carrito está vacío</p>
    </div>

    <!-- Upsell (fondo negro) -->
    <div id="cd-upsell" class="hidden mx-4 my-3 bg-black rounded-2xl px-4 py-3">
      <div class="flex items-center gap-3">
        <div class="flex-shrink-0 w-16 h-16 rounded-xl overflow-hidden bg-gray-800">
          <img id="cd-upsell-img" src="" alt="" class="w-full h-full object-cover" loading="lazy">
        </div>
        <div class="flex-1 min-w-0">
          <p id="cd-upsell-title" class="text-white font-bold text-sm leading-tight line-clamp-2"></p>
          <p id="cd-upsell-price" class="text-white/80 text-sm mt-0.5"></p>
        </div>
        <button
          type="button"
          onclick="CartDrawer.addUpsell()"
          class="flex-shrink-0 bg-white text-black font-bold text-sm px-4 py-2 rounded-xl hover:opacity-80 transition-opacity"
        >
          Agregar
        </button>
      </div>
    </div>

  </div>

  <!-- ── Footer ── -->
  <div class="flex-shrink-0 border-t border-gray-100 px-5 pt-4 pb-6 bg-white">
    <div class="flex justify-between items-center mb-1.5">
      <span class="text-lg font-bold text-black">Subtotal</span>
      <span id="cd-subtotal" class="text-lg font-bold text-black">—</span>
    </div>
    <p class="text-[11px] text-gray-400 leading-tight mb-4">
      *en la pantalla de pagos se incluye el impuesto y se calculan los gastos de envío.
    </p>
    <a
      href="{{ routes.checkout_url }}"
      class="block w-full bg-black text-white text-center font-bold py-4 rounded-2xl text-base hover:opacity-80 transition-opacity mb-4"
    >
      Realizar Pago Seguro
    </a>
    <!-- Métodos de pago -->
    <div class="flex justify-center gap-2 flex-wrap items-center">
      {%- for type in shop.enabled_payment_types -%}
        <span class="border border-gray-200 rounded-full px-3 py-1.5 flex items-center justify-center h-9">
          {{- type | payment_type_svg_tag: class: 'h-5 w-auto max-w-[60px]' -}}
        </span>
      {%- endfor -%}
    </div>
  </div>

</div>

<script>
  window.CART_MIN_CENTS  = {{ min_cents }};
  window.CART_FREE_CENTS = {{ free_cents }};
  window.CART_MONEY_FMT  = {{ shop.money_format | json }};
</script>
