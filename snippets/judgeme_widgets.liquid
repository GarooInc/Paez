{%- comment -%}
  Fallback stub for the Judge.me app snippet.
  The app overwrites this file when installed on Shopify.
  This stub renders via metafields so previews don't throw a Liquid error.
{%- endcomment -%}
{% if widget_type == 'judgeme_preview_badge' %}
  <div class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}'>
    {{ product.metafields.judgeme.badge }}
  </div>
{% elsif widget_type == 'judgeme_review_widget' %}
  <div class='jdgm-widget jdgm-review-widget' data-id='{{ product.id }}'>
    {{ product.metafields.judgeme.widget }}
  </div>
{% endif %}
