      "default": "0%"
    },
    {
      "type": "url",
      "id": "installments_info_url",
      "label": "URL 'Más información' cuotas"
    },
    {
      "type": "header",
      "content": "Tallas"
    },
    {
      "type": "url",
      "id": "size_chart_url",
      "label": "URL de la guía de tallas"
    },
    {
      "type": "header",
      "content": "Sección de detalles"
    },
    {
