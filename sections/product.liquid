      "default": true
    },
    {
      "type": "image_picker",
      "id": "highlights_image",
      "label": "Imagen de la sección highlights"
    },
    {
      "type": "header",
      "content": "Visibilidad de secciones"
    },
    {
      "type": "checkbox",
      "id": "show_upsells",
      "label": "Mostrar upsells",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_media_gallery",
      "label": "Mostrar galería de medios",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_faq",
      "label": "Mostrar FAQs",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "upsell",
      "name": "Upsell",
      "limit": 4,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Producto"
        }
      ]
    },
    {
      "type": "featured_review",
      "name": "Reseña destacada",
      "limit": 3,
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "Estrellas",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Increíble calidad"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Texto de la reseña",
          "default": "El tejido es suave pero firme. Se nota la diferencia nada más ponértela."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Autor",
          "default": "María, hace 2 días"
        }
      ]
    },
    {
      "type": "highlight_item",
      "name": "Punto destacado",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "¿Qué hace especial este producto?"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Descripción",
          "default": "Lorem Ipsum es simplemente el texto de relleno de las imprentas y archivos de texto."
        }
      ]
    },
    {
      "type": "media_item",
      "name": "Foto / Video",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "URL del video (opcional)"
