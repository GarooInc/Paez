{% comment %}
  Product page — WEB-PAEZ Figma node 292:4
{% endcomment %}

<style>
  /* FAQ smooth open/close animation via CSS grid trick */
  .faq-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s ease;
  }
  .faq-body > div { overflow: hidden; }
  details[open] .faq-body { grid-template-rows: 1fr; }
  details summary { list-style: none; }
  details summary::-webkit-details-marker { display: none; }

  /* Hide scrollbars on carousels while keeping scroll functionality */
  .no-scrollbar { scrollbar-width: none; -ms-overflow-style: none; }
  .no-scrollbar::-webkit-scrollbar { display: none; }
</style>

{% assign current_variant = product.selected_or_first_available_variant %}
{% assign color_option_index = nil %}
{% assign size_option_index = nil %}
{% for option in product.options_with_values %}
  {% if option.name == 'Color' or option.name == 'color' or option.name == 'Colour' or option.name == 'colour' %}
    {% assign color_option_index = forloop.index0 %}
  {% endif %}
  {% if option.name == 'Size' or option.name == 'size' or option.name == 'Talla' or option.name == 'talla' %}
    {% assign size_option_index = forloop.index0 %}
  {% endif %}
{% endfor %}

{% comment %} Detect single color from product tags when no color variant option exists {% endcomment %}
{% assign tag_color = nil %}
{% if color_option_index == nil %}
  {% for tag in product.tags %}
    {% assign _t = tag | downcase | strip %}
    {% if _t contains 'color:' %}
      {% assign tag_color = _t | remove: 'color:' | strip %}
      {% break %}
    {% endif %}
  {% endfor %}
  {% if tag_color == nil %}
    {% assign _known_colors = 'beige,camel,tan,arena,caramelo,rojo,red,coral,frambuesa,granate,marron,brown,castano,terracota,azul,blue,navy,marino,negro,black,blanco,white,verde,green,kaki,khaki,gris,grey,gray' | split: ',' %}
    {% for tag in product.tags %}
      {% assign _t = tag | downcase | strip %}
      {% for _c in _known_colors %}
        {% if _t == _c and tag_color == nil %}
          {% assign tag_color = _t %}
        {% endif %}
      {% endfor %}
    {% endfor %}
  {% endif %}
{% endif %}

<!-- ═══════════════════════════════════════════
     HERO — Images (left 60%) + Info panel (right 40%)
     ═══════════════════════════════════════════ -->
<div class="flex flex-col lg:flex-row lg:items-start pt-[120px]">

  <!-- Images -->
  <div class="lg:w-3/5">
    <!-- Mobile: horizontal snap carousel -->
    <div class="flex overflow-x-auto snap-x snap-mandatory lg:hidden no-scrollbar">
      {% for image in product.images limit: 4 %}
        <div class="min-w-full snap-start aspect-[4/5] shrink-0 overflow-hidden">
          <img
            src="{{ image | image_url: width: 800 }}"
            srcset="{{ image | image_url: width: 400 }} 400w, {{ image | image_url: width: 800 }} 800w"
            alt="{{ image.alt | default: product.title | escape }}"
            class="w-full h-full object-cover"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            width="800" height="1000"
          >
        </div>
      {% endfor %}
    </div>
    <!-- Desktop: 2×2 grid -->
    <div class="hidden lg:grid grid-cols-2 gap-[6px]">
      {% for image in product.images limit: 4 %}
        <div class="overflow-hidden aspect-[4/5]">
          <img
            src="{{ image | image_url: width: 900 }}"
            srcset="{{ image | image_url: width: 450 }} 450w, {{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1400 }} 1400w"
            alt="{{ image.alt | default: product.title | escape }}"
            class="w-full h-full object-cover !m-0"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            width="900" height="1125"
          >
        </div>
      {% endfor %}
    </div>
  </div>

  <!-- Info Panel -->
  <div class="lg:w-2/5 flex flex-col gap-5 p-6 lg:pt-0 lg:-mt-8 lg:px-8 lg:pb-8 xl:px-10 xl:pb-10">

    <!-- Title + Price + Rating + Description -->
    <div class="flex flex-col gap-3">
      <div class="flex items-start justify-between gap-4">
        <h1 class="text-2xl lg:text-3xl font-bold text-black leading-tight flex-1">
          {{ product.title }}
        </h1>
        <span class="text-2xl lg:text-3xl font-bold text-black whitespace-nowrap" id="product-price">
          {{ current_variant.price | money }}
        </span>
      </div>

      <!-- Start of Judge.me code -->
      <div style='{{ jm_style }}' class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}' data-auto-install='false'>
        {{ product.metafields.judgeme.badge }}
      </div>
      <!-- End of Judge.me code -->

      <p class="text-sm lg:text-base text-black leading-relaxed">
        {{ product.description | strip_html | truncate: 220 }}
      </p>
    </div>

    <hr class="border-black">

    {% form 'product', product, id: 'product-form' %}
      <input type="hidden" name="id" id="variant-id-input" value="{{ current_variant.id }}">

      <!-- Color selector -->
      {% if color_option_index != nil or tag_color != nil %}
        <div class="flex flex-col gap-4">
          <p class="text-lg xl:text-xl font-bold text-black">Selecciona un color</p>
          <div class="flex gap-3 flex-wrap">
            {% if color_option_index != nil %}
              {% assign color_option = product.options_with_values[color_option_index] %}
              {% assign color_position = color_option_index | plus: 1 %}
              {% for value in color_option.values %}
                {%- assign is_selected = false -%}
                {%- if color_option_index == 0 and current_variant.option1 == value -%}{%- assign is_selected = true -%}{%- endif -%}
                {%- if color_option_index == 1 and current_variant.option2 == value -%}{%- assign is_selected = true -%}{%- endif -%}
                {%- if color_option_index == 2 and current_variant.option3 == value -%}{%- assign is_selected = true -%}{%- endif -%}
                {%- render 'color-swatch', value: value, position: color_position, is_selected: is_selected -%}
              {% endfor %}
            {% else %}
              {%- render 'color-swatch', value: tag_color, is_selected: true -%}
            {% endif %}
          </div>
        </div>
        <hr class="border-black">
      {% endif %}

      <!-- Size selector -->
      {% if size_option_index != nil %}
        {% assign size_option = product.options_with_values[size_option_index] %}
        {% assign size_position = size_option_index | plus: 1 %}
        <div class="flex flex-col gap-4">
          <div class="flex items-center justify-between gap-3">
            <p class="text-lg xl:text-xl font-bold text-black">Selecciona una talla</p>
            <a
              href="{{ section.settings.size_chart_url | default: '#' }}"
              class="text-sm font-bold text-black underline flex items-center gap-1.5 shrink-0"
              {% if section.settings.size_chart_url != blank %}target="_blank" rel="noopener"{% endif %}
              aria-label="Guía de tallas"
            >
              <svg class="w-4 h-4" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <rect x="1" y="1" width="18" height="12" rx="1.5"/>
                <path d="M5 1v3M9 1v4.5M13 1v3" stroke-linecap="round"/>
              </svg>
              Guía de tallas
            </a>
          </div>
          <div class="flex gap-3 flex-wrap">
            {% for value in size_option.values %}
              {%- assign size_available = false -%}
              {%- for variant in product.variants -%}
                {%- if variant.available -%}
                  {%- if size_position == 1 and variant.option1 == value -%}{%- assign size_available = true -%}{%- endif -%}
                  {%- if size_position == 2 and variant.option2 == value -%}{%- assign size_available = true -%}{%- endif -%}
                  {%- if size_position == 3 and variant.option3 == value -%}{%- assign size_available = true -%}{%- endif -%}
                {%- endif -%}
              {%- endfor -%}

              {%- assign is_size_selected = false -%}
              {%- if size_option_index == 0 and current_variant.option1 == value -%}{%- assign is_size_selected = true -%}{%- endif -%}
              {%- if size_option_index == 1 and current_variant.option2 == value -%}{%- assign is_size_selected = true -%}{%- endif -%}
              {%- if size_option_index == 2 and current_variant.option3 == value -%}{%- assign is_size_selected = true -%}{%- endif -%}

              <button
                type="button"
                class="size-swatch relative w-[52px] h-[52px] xl:w-[58px] xl:h-[58px] rounded-2xl font-bold text-sm transition-all
                  {% if size_available %}bg-black text-white{% else %}bg-gray-200 text-gray-400 cursor-not-allowed{% endif %}
                  {% if is_size_selected %}ring-2 ring-black ring-offset-1{% endif %}"
                data-option-position="{{ size_position }}"
                data-option-value="{{ value | escape }}"
                data-available="{{ size_available }}"
                {% unless size_available %}disabled aria-disabled="true"{% endunless %}
              >
                {{ value }}
                {% if is_size_selected %}
                  <span class="absolute bottom-2 left-1/2 -translate-x-1/2 w-8 h-[3px] bg-white rounded-full"></span>
                {% endif %}
              </button>
            {% endfor %}
          </div>
        </div>
      {% else %}
        <select name="id" class="w-full p-3 border border-black rounded-2xl font-bold bg-white text-base">
          {% for variant in product.variants %}
            <option value="{{ variant.id }}" {% if variant == current_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
              {{ variant.title }} — {{ variant.price | money }}
            </option>
          {% endfor %}
        </select>
      {% endif %}

      <!-- Add to cart + Payment -->
      <div class="flex flex-col gap-3 mt-2">
        <button
          type="submit"
          name="add"
          id="add-to-cart-btn"
          class="w-full bg-black text-white font-bold text-lg py-4 rounded-2xl hover:opacity-90 transition-opacity disabled:opacity-40 disabled:cursor-not-allowed"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          {% if current_variant.available %}Agregar al carrito{% else %}Agotado{% endif %}
        </button>
        {{ form | payment_button }}
      </div>
    {% endform %}

    <!-- Installments -->
    <p class="text-sm lg:text-base text-black text-center leading-relaxed">
      Pagar {{ section.settings.installments_count }} cuotas sin intereses ({{ section.settings.installments_tae }} TAE) de
      <strong id="installments-price">{{ current_variant.price | divided_by: section.settings.installments_count | money }}</strong>.
      {% if section.settings.installments_info_url != blank %}
        <a href="{{ section.settings.installments_info_url }}" class="underline font-bold italic">Más información.</a>
      {% else %}
        <em class="font-bold">Más información.</em>
      {% endif %}
    </p>

    <div class="flex justify-around items-center gap-2 p-6 mt-4 border-2 border-black rounded-[28px]">
      {%- render 'trust-badge', asset: 'badge-envio.svg', label: 'Envío gratuito' -%}
      <div class="w-px self-stretch bg-black opacity-20"></div>
      {%- render 'trust-badge', asset: 'badge-devolucion.svg', label: 'Devoluciones', label2: 'en 30 días' -%}
      <div class="w-px self-stretch bg-black opacity-20"></div>
      {%- render 'trust-badge', asset: 'badge-pago.svg', label: 'Pago seguro' -%}
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════
     FEATURED REVIEWS — 3 tarjetas horizontales + arrows
     ═══════════════════════════════════════════ -->
{% assign has_reviews = false %}
{% for block in section.blocks %}
  {% if block.type == 'featured_review' %}{% assign has_reviews = true %}{% endif %}
{% endfor %}
{% if has_reviews %}
  <div class="py-14 px-4 lg:px-16 border-t border-gray-100 relative overflow-hidden">
    <!-- Decorative arrow left -->
    <div class="hidden lg:flex absolute left-4 top-1/2 -translate-y-1/2 z-10">
      <svg class="w-10 h-10 text-black" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="20" cy="20" r="18.5"/>
        <path d="M23 13l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <!-- Decorative arrow right -->
    <div class="hidden lg:flex absolute right-4 top-1/2 -translate-y-1/2 z-10">
      <svg class="w-10 h-10 text-black" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="20" cy="20" r="18.5"/>
        <path d="M17 13l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>

    <!-- Cards -->
    <div class="flex gap-10 overflow-x-auto no-scrollbar pb-4 snap-x snap-mandatory lg:justify-center lg:overflow-visible">
      {% for block in section.blocks %}
        {% if block.type == 'featured_review' %}
          <div class="flex flex-col gap-4 min-w-[280px] max-w-[360px] lg:min-w-0 lg:flex-1 shrink-0 snap-start" {{ block.shopify_attributes }}>
            <!-- Stars -->
            <div class="flex gap-1" aria-label="{{ block.settings.stars }} de 5 estrellas">
              {% assign star_count = block.settings.stars | default: 5 %}
              {% for i in (1..5) %}
                {% if i <= star_count %}
                  <svg class="w-5 h-5 text-black" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                {% else %}
                  <svg class="w-5 h-5 text-gray-200" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                {% endif %}
              {% endfor %}
            </div>
            <div>
              <p class="text-xl lg:text-2xl font-bold text-black">{{ block.settings.title }}</p>
              <p class="text-base text-black leading-relaxed mt-2">{{ block.settings.body }}</p>
            </div>
            <p class="text-sm font-bold text-black">{{ block.settings.author }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Reviews summary -->
    {% if section.settings.reviews_summary != blank %}
      <p class="text-center text-sm lg:text-base text-black mt-8 italic">{{ section.settings.reviews_summary }}</p>
    {% endif %}
  </div>
{% endif %}

<!-- ═══════════════════════════════════════════
     UPSELLS
     ═══════════════════════════════════════════ -->
{% if section.settings.show_upsells %}
  {% assign has_upsells = false %}
  {% for block in section.blocks %}
    {% if block.type == 'upsell' %}{% assign has_upsells = true %}{% endif %}
  {% endfor %}
  {% if has_upsells %}
    <div class="py-14 px-4 lg:px-10 border-t border-gray-100">
      <h2 class="text-3xl lg:text-4xl font-bold text-black text-center mb-10">Upsells</h2>
      <div class="flex gap-6 overflow-x-auto no-scrollbar pb-4 snap-x snap-mandatory lg:justify-center">
        {% for block in section.blocks %}
          {% if block.type == 'upsell' %}
            {% assign upsell_product = all_products[block.settings.product] %}
            {% if upsell_product != blank %}
              <div class="flex flex-col items-center gap-4 min-w-[200px] max-w-[240px] shrink-0 snap-start" {{ block.shopify_attributes }}>
                <div class="rounded-[22px] overflow-hidden w-full aspect-square bg-gray-100">
                  {% if upsell_product.featured_image %}
                    <img
                      src="{{ upsell_product.featured_image | image_url: width: 480 }}"
                      alt="{{ upsell_product.title | escape }}"
                      class="w-full h-full object-cover"
                      loading="lazy" width="480" height="480"
                    >
                  {% endif %}
                </div>
                <div class="text-center">
                  <p class="font-bold text-base">{{ upsell_product.title }}</p>
                  <p class="text-sm text-gray-600">{{ upsell_product.price | money }}</p>
                </div>
                <form action="/cart/add" method="post">
                  <input type="hidden" name="id" value="{{ upsell_product.selected_or_first_available_variant.id }}">
                  <button type="submit" class="bg-black text-white font-bold text-sm px-8 py-3 rounded-[14px] hover:opacity-80 transition-opacity">
                    Agregar
                  </button>
                </form>
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}
{% endif %}

<!-- ═══════════════════════════════════════════
     STICKY BAR — Fija debajo de Upsells
     ═══════════════════════════════════════════ -->
<div id="sticky-bar" class="full-width sticky top-0 z-40 bg-black text-white">
  <div class="flex items-center gap-4 px-4 py-4 max-w-screen-2xl mx-auto">
    {% if product.featured_image %}
      <img
        src="{{ product.featured_image | image_url: width: 90 }}"
        alt="{{ product.title | escape }}"
        class="w-14 h-14 rounded-xl object-cover shrink-0"
        loading="lazy" width="56" height="56"
      >
    {% endif %}
    <div class="flex flex-col min-w-0 flex-1">
      <span class="font-bold text-sm truncate">{{ product.title }}</span>
      <span class="text-sm text-gray-300" id="sticky-price">{{ current_variant.price | money }}</span>
    </div>
    {% if color_option_index != nil %}
      {% assign color_option_sticky = product.options_with_values[color_option_index] %}
      <div class="hidden md:flex gap-2 shrink-0">
        {% for value in color_option_sticky.values %}
          {%- render 'color-swatch', value: value, mode: 'sticky' -%}
        {% endfor %}
      </div>
    {% endif %}
    <button
      type="button"
      id="sticky-add-btn"
      class="bg-white text-black font-bold text-sm px-6 py-3 rounded-[14px] shrink-0 hover:opacity-90 transition-opacity"
    >
      Agregar al Carrito
    </button>
  </div>
</div>

<!-- ═══════════════════════════════════════════
     HIGHLIGHTS — Tarjeta negra: imagen + puntos numerados
     ═══════════════════════════════════════════ -->
{% if section.settings.show_highlights %}
  {% assign has_highlights = false %}
  {% for block in section.blocks %}
    {% if block.type == 'highlight_item' %}{% assign has_highlights = true %}{% endif %}
  {% endfor %}
  {% if has_highlights %}
    <div class="px-4 lg:px-6 py-6">
      <div class="bg-black rounded-[30px] overflow-hidden">
        <div class="flex flex-col lg:flex-row">

          <!-- Left: configurable image -->
          <div class="lg:w-[44%] p-4 lg:p-6">
            {% if section.settings.highlights_image %}
              <div class="rounded-[22px] overflow-hidden h-full min-h-[280px] lg:min-h-[460px]">
                <img
                  src="{{ section.settings.highlights_image | image_url: width: 800 }}"
                  alt="{{ product.title | escape }}"
                  class="w-full h-full object-cover"
                  loading="lazy" width="800" height="1000"
                >
              </div>
            {% else %}
              <!-- Placeholder when no image is set -->
              <div class="rounded-[22px] bg-white/5 border border-white/10 h-full min-h-[280px] lg:min-h-[460px] flex items-center justify-center">
                <svg class="w-20 h-20 text-white/20" fill="none" stroke="currentColor" viewBox="0 0 80 80" aria-hidden="true">
                  <rect x="8" y="20" width="64" height="44" rx="5" stroke-width="2"/>
                  <circle cx="40" cy="42" r="11" stroke-width="2"/>
                  <path d="M28 20l4-8h16l4 8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            {% endif %}
          </div>

          <!-- Right: numbered items -->
          <div class="lg:w-[56%] flex flex-col justify-center p-6 lg:p-10 gap-8 lg:gap-10">
            {% assign h_idx = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'highlight_item' %}
                {% assign h_idx = h_idx | plus: 1 %}
                <div {{ block.shopify_attributes }}>
                  <p class="text-white font-bold text-xl lg:text-2xl leading-snug">{{ h_idx }}. {{ block.settings.title }}</p>
                  {% if block.settings.body != blank %}
                    <p class="text-white/65 text-base lg:text-lg leading-relaxed mt-2">{{ block.settings.body }}</p>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>

        </div>
      </div>
    </div>
  {% endif %}
{% endif %}

<!-- ═══════════════════════════════════════════
     PRODUCT DETAILS — Descripción + features + imagen grande
     ═══════════════════════════════════════════ -->
<div class="py-14 px-4 lg:px-10 border-t border-gray-100">
  <div class="flex flex-col lg:flex-row gap-10 lg:gap-14">

    <!-- Left: title + description + features accordion + CTA -->
    <div class="lg:w-1/2 flex flex-col gap-8">
      <div>
        <h2 class="text-3xl xl:text-4xl 2xl:text-5xl font-bold text-black">{{ product.title }}</h2>
        <div class="text-base lg:text-lg text-black mt-4 leading-relaxed prose max-w-none">
          {{ product.description }}
        </div>
      </div>

      {% if section.settings.product_features != blank %}
        <div class="flex flex-col">
          {% assign features = section.settings.product_features | split: '|' %}
          {% for feature in features %}
            {% assign trimmed = feature | strip %}
            {% if trimmed != blank %}
              <div class="border-t border-black py-4">
                <p class="text-lg xl:text-xl font-bold text-black">{{ trimmed }}</p>
              </div>
            {% endif %}
          {% endfor %}
          <div class="border-t border-black"></div>
        </div>
      {% endif %}

      <form action="/cart/add" method="post">
        <input type="hidden" name="id" class="variant-id-sync" value="{{ current_variant.id }}">
        <button type="submit" class="bg-black text-white font-bold text-lg xl:text-xl py-5 px-10 rounded-[23px] hover:opacity-80 transition-opacity w-full lg:w-auto">
          Agregar al Carrito
        </button>
      </form>
    </div>

    <!-- Right: large product image (5th image, configurable, or hidden) -->
    <div class="lg:w-1/2">
      {% if section.settings.detail_image %}
        <div class="rounded-[22px] overflow-hidden aspect-[4/5] bg-gray-100">
          <img
            src="{{ section.settings.detail_image | image_url: width: 900 }}"
            alt="{{ product.title | escape }}"
            class="w-full h-full object-cover"
            loading="lazy" width="900" height="1125"
          >
        </div>
      {% elsif product.images[4] %}
        <div class="rounded-[22px] overflow-hidden aspect-[4/5] bg-gray-100">
          <img
            src="{{ product.images[4] | image_url: width: 900 }}"
            alt="{{ product.title | escape }}"
            class="w-full h-full object-cover"
            loading="lazy" width="900" height="1125"
          >
        </div>
      {% endif %}
    </div>

  </div>
</div>

<!-- ═══════════════════════════════════════════
     MEDIA GALLERY — Lifestyle fotos/videos con ícono cámara
     ═══════════════════════════════════════════ -->
{% if section.settings.show_media_gallery %}
  {% assign has_media = false %}
  {% for block in section.blocks %}
    {% if block.type == 'media_item' %}{% assign has_media = true %}{% endif %}
  {% endfor %}
  {% if has_media %}
    <div class="full-width py-12 bg-gray-50 border-t border-gray-100">
      <div class="flex gap-4 overflow-x-auto no-scrollbar px-4 lg:px-10 pb-4 snap-x snap-mandatory">
        {% for block in section.blocks %}
          {% if block.type == 'media_item' %}
            <div class="min-w-[200px] lg:min-w-[240px] rounded-[22px] overflow-hidden shrink-0 aspect-[9/16] relative snap-start bg-gray-200" {{ block.shopify_attributes }}>
              {% if block.settings.image %}
                <img
                  src="{{ block.settings.image | image_url: width: 400 }}"
                  alt="{{ block.settings.alt | default: product.title | escape }}"
                  class="absolute inset-0 w-full h-full object-cover"
                  loading="lazy" width="400" height="711"
                >
              {% endif %}
              <!-- Camera icon — always visible, matches Figma -->
              <div class="absolute top-3 left-3 w-10 h-10 bg-black/65 rounded-xl flex items-center justify-center backdrop-blur-sm">
                {% if block.settings.video_url != blank %}
                  <svg class="w-5 h-5 text-white ml-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"/>
                  </svg>
                {% else %}
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574v9.176A2.25 2.25 0 004.5 21h15a2.25 2.25 0 002.25-2.25V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0z"/>
                  </svg>
                {% endif %}
              </div>
              {% if block.settings.video_url != blank %}
                <a href="{{ block.settings.video_url }}" target="_blank" rel="noopener" class="absolute inset-0" aria-label="Ver vídeo"></a>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}
{% endif %}

<!-- ═══════════════════════════════════════════
     REVIEWS — Widget Judge.me
     ═══════════════════════════════════════════ -->
<div class="py-14 px-4 lg:px-10 border-t border-gray-100">
  {% render 'judgeme_widgets', widget_type: 'judgeme_review_widget', concierge_install: true, product: product %}
</div>

<!-- ═══════════════════════════════════════════
     FAQS — Título FAQS gigante + acordeón animado
     ═══════════════════════════════════════════ -->
{% if section.settings.show_faq %}
  {% assign has_faqs = false %}
  {% for block in section.blocks %}
    {% if block.type == 'faq_item' %}{% assign has_faqs = true %}{% endif %}
  {% endfor %}
  {% if has_faqs %}
    <div class="py-14 px-4 lg:px-10 border-t border-gray-100">
      <div class="flex flex-col lg:flex-row gap-10 lg:gap-16">
        <div class="lg:w-1/3">
          <h2 class="text-6xl lg:text-7xl xl:text-8xl font-bold text-black leading-none">FAQS</h2>
        </div>
        <div class="lg:w-2/3">
          {% for block in section.blocks %}
            {% if block.type == 'faq_item' %}
              <details class="border-t border-black group" {{ block.shopify_attributes }}>
                <summary class="py-4 lg:py-5 text-base lg:text-lg xl:text-xl font-bold text-black cursor-pointer list-none flex justify-between items-center gap-4">
                  {{ block.settings.question }}
                  <svg class="w-5 h-5 shrink-0 transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </summary>
                <div class="faq-body">
                  <div>
                    <p class="pb-5 pt-1 text-base text-black leading-relaxed">{{ block.settings.answer }}</p>
                  </div>
                </div>
              </details>
            {% endif %}
          {% endfor %}
          <div class="border-t border-black"></div>
        </div>
      </div>
    </div>
  {% endif %}
{% endif %}


<script>
(function () {
  const productVariants = {{ product.variants | json }};
  const moneyFormat = {{ shop.money_format | json }};
  const installmentsCount = {{ section.settings.installments_count }};

  const selectedOptions = {
    {% for option in product.options_with_values %}
      {% assign opt_key = 'option' | append: forloop.index %}
      {{ forloop.index }}: {{ current_variant[opt_key] | json }}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  };

  function formatMoney(cents) {
    if (window.Shopify && window.Shopify.formatMoney) {
      return window.Shopify.formatMoney(cents, moneyFormat);
    }
    return moneyFormat.replace('{{amount}}', (cents / 100).toFixed(2))
                      .replace('{{amount_no_decimals}}', Math.round(cents / 100));
  }

  function findVariant() {
    return productVariants.find(function (v) {
      return Object.keys(selectedOptions).every(function (pos) {
        return v['option' + pos] === selectedOptions[pos];
      });
    });
  }

  function updateUI(variant) {
    if (!variant) return;

    document.querySelectorAll('#variant-id-input, .variant-id-sync').forEach(function (el) {
      el.value = variant.id;
    });

    var priceFormatted = formatMoney(variant.price);
    var priceEl = document.getElementById('product-price');
    if (priceEl) priceEl.textContent = priceFormatted;
    var stickyPrice = document.getElementById('sticky-price');
    if (stickyPrice) stickyPrice.textContent = priceFormatted;

    var installEl = document.getElementById('installments-price');
    if (installEl) installEl.textContent = formatMoney(Math.round(variant.price / installmentsCount));

    var btn = document.getElementById('add-to-cart-btn');
    if (btn) {
      btn.disabled = !variant.available;
      btn.textContent = variant.available ? 'Agregar al carrito' : 'Agotado';
    }

    var url = new URL(window.location.href);
    url.searchParams.set('variant', variant.id);
    window.history.replaceState({}, '', url.toString());
  }

  // Color swatches
  document.querySelectorAll('.color-swatch').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var pos = btn.dataset.optionPosition;
      document.querySelectorAll('.color-swatch[data-option-position="' + pos + '"]').forEach(function (b) {
        b.classList.remove('ring-2', 'ring-black', 'ring-offset-1');
        var bar = b.querySelector('span');
        if (bar) bar.remove();
      });
      btn.classList.add('ring-2', 'ring-black', 'ring-offset-1');
      if (!btn.querySelector('span')) {
        var bar = document.createElement('span');
        bar.className = 'w-8 h-[3px] bg-white rounded-full';
        btn.appendChild(bar);
      }
      selectedOptions[pos] = btn.dataset.optionValue;
      updateUI(findVariant());
    });
  });

  // Size swatches
  document.querySelectorAll('.size-swatch:not([disabled])').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var pos = btn.dataset.optionPosition;
      document.querySelectorAll('.size-swatch[data-option-position="' + pos + '"]').forEach(function (b) {
        b.classList.remove('ring-2', 'ring-black', 'ring-offset-1');
        var bar = b.querySelector('span');
        if (bar) bar.remove();
      });
      btn.classList.add('ring-2', 'ring-black', 'ring-offset-1');
      var bar = document.createElement('span');
      bar.className = 'absolute bottom-2 left-1/2 -translate-x-1/2 w-8 h-[3px] bg-white rounded-full';
      btn.appendChild(bar);
      selectedOptions[pos] = btn.dataset.optionValue;
      updateUI(findVariant());
    });
  });

  // Sticky add to cart — delegates to main form button with correct variant
  var stickyBtn = document.getElementById('sticky-add-btn');
  if (stickyBtn) {
    stickyBtn.addEventListener('click', function () {
      var mainBtn = document.getElementById('add-to-cart-btn');
      if (mainBtn) mainBtn.click();
    });
  }
})();
</script>

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
