<style>
  .mfs-section {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding: 80px 40px;
    box-sizing: border-box;
  }
  .mfs-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    gap: 60px;
    align-items: flex-start;
  }
  /* Left column */
  .mfs-left {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .mfs-title {
    font-size: 2rem;
    font-weight: 700;
    color: #000;
    line-height: 1.15;
    margin: 0 0 16px;
  }
  .mfs-desc {
    font-size: 1rem;
    color: #374151;
    line-height: 1.7;
    margin: 0 0 8px;
  }
  /* Accordion list */
  .mfs-accordion {
    margin: 16px 0 32px;
  }
  .mfs-accordion-divider {
    height: 1px;
    background: #000;
    border: none;
    margin: 0;
  }
  .mfs-accordion-item {
    overflow: hidden;
  }
  .mfs-accordion-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-size: 1.0625rem;
    font-weight: 700;
    color: #000;
    gap: 12px;
    transition: opacity 0.15s;
  }
  .mfs-accordion-trigger:hover { opacity: 0.7; }
  .mfs-accordion-arrow {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
    color: #000;
  }
  .mfs-accordion-item.is-open .mfs-accordion-arrow {
    transform: rotate(180deg);
  }
  .mfs-accordion-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }
  .mfs-accordion-item.is-open .mfs-accordion-body {
    grid-template-rows: 1fr;
  }
  .mfs-accordion-body-inner {
    overflow: hidden;
    font-size: 0.9375rem;
    color: #6b7280;
    line-height: 1.6;
    padding-bottom: 16px;
  }
  /* CTA button */
  .mfs-btn {
    display: inline-block;
    background: #000;
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
    padding: 16px 32px;
    border-radius: 12px;
    text-decoration: none;
    transition: opacity 0.15s;
    align-self: flex-start;
    margin-top: 8px;
    border: none;
    cursor: pointer;
  }
  .mfs-btn:hover { opacity: 0.8; color: #fff; }
  /* Right column */
  .mfs-right {
    flex: 1;
    min-width: 0;
  }
  .mfs-image-wrap {
    width: 100%;
    aspect-ratio: 3/4;
    border-radius: 20px;
    overflow: hidden;
    background: #f3f4f6;
  }
  .mfs-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Mobile */
  @media (max-width: 767px) {
    .mfs-section { padding: 48px 20px; }
    .mfs-inner { flex-direction: column; gap: 32px; }
    .mfs-title { font-size: 1.5rem; }
    .mfs-image-wrap { aspect-ratio: 4/3; }
    .mfs-btn { width: 100%; text-align: center; box-sizing: border-box; }
  }
</style>

<section class="mfs-section">
  <div class="mfs-inner">

    <!-- Columna izquierda: texto -->
    <div class="mfs-left">
      <h2 class="mfs-title">{{ section.settings.title }}</h2>

      {% if section.settings.description != blank %}
        <p class="mfs-desc">{{ section.settings.description }}</p>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="mfs-accordion">
          <hr class="mfs-accordion-divider">
          {% for block in section.blocks %}
            <div class="mfs-accordion-item" {{ block.shopify_attributes }}>
              <button
                class="mfs-accordion-trigger"
                aria-expanded="false"
                onclick="mfsToggle(this)"
                type="button"
              >
                <span>{{ block.settings.title }}</span>
                <svg class="mfs-accordion-arrow" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2.5"
                     stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </button>
              {% if block.settings.body != blank %}
                <div class="mfs-accordion-body">
                  <div class="mfs-accordion-body-inner">
                    {{ block.settings.body }}
                  </div>
                </div>
              {% endif %}
            </div>
            <hr class="mfs-accordion-divider">
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_url }}" class="mfs-btn">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>

    <!-- Columna derecha: imagen -->
    <div class="mfs-right">
      <div class="mfs-image-wrap">
        {% if section.settings.image %}
          <img
            src="{{ section.settings.image | image_url: width: 1000 }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            alt="{{ section.settings.image.alt | default: section.settings.title }}"
            loading="lazy"
          >
        {% else %}
          <div style="width:100%;height:100%;background:#e5e7eb;display:flex;align-items:center;justify-content:center;">
            <span style="color:#9ca3af;font-size:0.875rem;">Agrega una imagen</span>
          </div>
        {% endif %}
      </div>
    </div>

  </div>
</section>

<script>
  function mfsToggle(btn) {
    var item = btn.closest('.mfs-accordion-item');
    var isOpen = item.classList.contains('is-open');
    item.classList.toggle('is-open', !isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
  }
</script>

{% schema %}
{
  "name": "Feature Highlight",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Nombre del Producto"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción",
      "default": "Lorem Ipsum es simplemente el texto de relleno de las imprentas y archivos de texto."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen (derecha)"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto del botón",
      "default": "Agregar al Carrito"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "URL del botón"
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título del item",
          "default": "Lorem Ipsum es simplemente el texto"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Contenido (opcional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Highlight",
      "category": "main",
      "blocks": [
        { "type": "accordion", "settings": { "title": "Lorem Ipsum es simplemente el texto" } },
        { "type": "accordion", "settings": { "title": "Lorem Ipsum es simplemente el texto" } },
        { "type": "accordion", "settings": { "title": "Lorem Ipsum es simplemente el texto" } },
        { "type": "accordion", "settings": { "title": "Lorem Ipsum es simplemente el texto" } },
        { "type": "accordion", "settings": { "title": "Lorem Ipsum es simplemente el texto" } }
      ]
    }
  ]
}
{% endschema %}
